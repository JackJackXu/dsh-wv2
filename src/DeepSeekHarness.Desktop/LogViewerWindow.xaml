<Window x:Class="DeepSeekHarness.Desktop.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DSH WV2 · 日志查看器"
        Width="760" Height="500" MinWidth="560" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E" ShowInTaskbar="False">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Background="#252525" LastChildFill="False">
            <Button x:Name="RefreshBtn" Content="刷新" Padding="10,4" Margin="8,8,0,8"
                    Click="RefreshBtn_Click" DockPanel.Dock="Left" />
            <Button x:Name="OpenDirBtn" Content="打开日志目录" Padding="10,4" Margin="6,8,0,8"
                    Click="OpenDirBtn_Click" DockPanel.Dock="Left" />
            <Button x:Name="ClearBtn" Content="清空" Padding="10,4" Margin="6,8,0,8"
                    Click="ClearBtn_Click" DockPanel.Dock="Left" />
            <TextBlock Text="级别：" VerticalAlignment="Center" Margin="12,0,4,0"
                       Foreground="#CFD8DC" DockPanel.Dock="Right" />
            <ComboBox x:Name="LevelFilter" Width="120" Margin="0,8,8,8" DockPanel.Dock="Right"
                      SelectionChanged="LevelFilter_SelectionChanged">
                <ComboBoxItem Content="全部" IsSelected="True" />
                <ComboBoxItem Content="错误/警告" />
                <ComboBoxItem Content="仅信息" />
            </ComboBox>
        </DockPanel>
        <TextBox x:Name="LogBox" Background="#1E1E1E" Foreground="#E6EDF3"
                 FontFamily="Consolas" FontSize="11" IsReadOnly="True"
                 TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto" Padding="8" />
    </DockPanel>
</Window>
